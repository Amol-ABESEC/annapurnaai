{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
    "source": "/((?!api/).*)",
     "destination": "/index.html"
}
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "cuisine_updated.csv",
      "maxDuration": 30
    }

  }
}
